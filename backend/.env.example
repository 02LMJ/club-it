# MySQL 접속 정보 (내 PC에 MySQL 설치할 때 정한 값으로 바꾸세요)
DB_USER=root
DB_PASSWORD=여기에_MySQL_비밀번호
DB_HOST=localhost
DB_PORT=3306
DB_NAME=clubit

# 로그인 토큰 서명용 비밀키 (아무 긴 문자열로 바꾸세요. 외부에 공개 금지)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# LLM 작성 보조 (mock이면 API 키 없이 예시 응답)
# LLM_PROVIDER: mock | anthropic | openai | ollama
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=
OLLAMA_URL=http://localhost:11434

# 배포 시 앱/웹 주소만 허용하도록 바꾸기 (쉼표로 구분)
CORS_ORIGINS=*
